{
    "actorSpecification": 1,
    "name": "global-business-marketplace-scraper",
    "title": "Global Business Marketplace Scraper",
    "description": "Automated scraper for GlobalBizM.com that extracts detailed data from businesses for sale, including: company title, brief description, category/industry, asking price, revenue, cash flow, geographic location, contact information, listing URL, images, and reasons for selling.",
    "version": "0.0",
    "meta": {
        "templateId": "js-crawlee-playwright-chrome"
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Business Listings",
            "description": "Scraped business listings from GlobalBizM.com",
            "views": {
                "overview": {
                    "title": "Overview",
                    "description": "Complete overview of business listings",
                    "transformation": {
                        "fields": [
                            "PrimaryImage",
                            "title",
                            "description",
                            "category",
                            "askingPrice",
                            "city",
                            "state",
                            "country",
                            "sellingReason",
                            "url",
                            "scrapedTimestamp"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "PrimaryImage": {
                                "label": "Image",
                                "format": "image"
                            },
                            "title": {
                                "label": "Business Name",
                                "format": "text"
                            },
                            "description": {
                                "label": "Description",
                                "format": "text"
                            },
                            "category": {
                                "label": "Industry",
                                "format": "text"
                            },
                            "askingPrice": {
                                "label": "Asking Price",
                                "format": "number"
                            },
                            "city": {
                                "label": "City",
                                "format": "text"
                            },
                            "state": {
                                "label": "State",
                                "format": "text"
                            },
                            "country": {
                                "label": "Country",
                                "format": "text"
                            },
                            "sellingReason": {
                                "label": "Reason for Sale",
                                "format": "text"
                            },
                            "url": {
                                "label": "View Business",
                                "format": "link"
                            },
                            "scrapedTimestamp": {
                                "label": "Scraped Date",
                                "format": "date"
                            }
                        }
                    }
                },
                "financial": {
                    "title": "Financial Details",
                    "description": "Financial metrics and pricing information",
                    "transformation": {
                        "fields": [
                            "PrimaryImage",
                            "title",
                            "askingPrice",
                            "grossRevenue",
                            "cashFlow",
                            "currency",
                            "establishedYear",
                            "sellingReason",
                            "url",
                            "scrapedTimestamp"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "PrimaryImage": {
                                "label": "Image",
                                "format": "image"
                            },
                            "title": {
                                "label": "Business Name",
                                "format": "text"
                            },
                            "askingPrice": {
                                "label": "Asking Price",
                                "format": "number"
                            },
                            "grossRevenue": {
                                "label": "Gross Revenue",
                                "format": "number"
                            },
                            "cashFlow": {
                                "label": "Cash Flow",
                                "format": "number"
                            },
                            "currency": {
                                "label": "Currency",
                                "format": "text"
                            },
                            "establishedYear": {
                                "label": "Est. Year",
                                "format": "number"
                            },
                            "sellingReason": {
                                "label": "Reason for Sale",
                                "format": "text"
                            },
                            "url": {
                                "label": "View Business",
                                "format": "link"
                            },
                            "scrapedTimestamp": {
                                "label": "Scraped Date",
                                "format": "date"
                            }
                        }
                    }
                },
                "contactInformation": {
                    "title": "Contact Information",
                    "description": "Location and contact details",
                    "transformation": {
                        "fields": [
                            "PrimaryImage",
                            "title",
                            "city",
                            "state",
                            "country",
                            "contactName",
                            "contactEmail",
                            "contactPhone",
                            "url",
                            "scrapedTimestamp" 
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "PrimaryImage": {
                                "label": "Image",
                                "format": "image"
